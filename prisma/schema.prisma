generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Neon's `-pooler` host) — used by the running app.
  // Serverless functions open many concurrent connections; without pooling
  // they exhaust Postgres's connection limit and requests hang instead of failing.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection — used only for `prisma migrate deploy`.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUBSCRIBER
  HANDICAPPER
  ADMIN
}

enum PickResult {
  PENDING
  WIN
  LOSS
  PUSH
  VOID
}

enum PickSport {
  NFL
  NBA
  WNBA
  MLB
  NHL
  NCAAF
  NCAAB
  SOCCER
  GOLF
  TENNIS
  UFC_MMA
  OTHER
}

enum BetType {
  SPREAD
  MONEYLINE
  TOTAL
  PROP
  PARLAY
  FUTURES
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

// Currencies a handicapper can price their packages in.
enum PriceCurrency {
  USD
  EUR
  GBP
}

// The handicapper's own plan with the platform (what THEY pay US, and at
// what commission rate) — distinct from Subscription, which is a fan
// paying a handicapper for picks.
enum HandicapperPlan {
  FREE
  SILVER
  GOLD
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  // Login identity chosen at signup; usable in place of email to sign in.
  // Stored lowercased so uniqueness and lookups are case-insensitive. Nullable
  // for legacy/Google accounts that predate the field (they sign in by email).
  username         String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  // Self-reported country, collected at signup (ISO country name).
  country          String?
  role             Role      @default(SUBSCRIBER)
  // Soft ban: suspended users can't sign in or act; data stays intact.
  suspendedAt      DateTime?
  // Brute-force protection: consecutive failed password attempts and, once the
  // threshold is hit, the moment the account unlocks. Reset on a successful login.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  // Superadmins have every admin permission and can manage other admins.
  // Bootstrapped from ADMIN_EMAILS/SUPERADMIN_EMAILS; can also be granted in-app.
  isSuperAdmin     Boolean   @default(false)
  // For scoped admins (role ADMIN, not superadmin): the set of admin-panel
  // permission keys they're allowed. See ADMIN_PERMISSIONS in src/lib/permissions.ts.
  adminPermissions String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  handicapper   HandicapperProfile?
  subscriptions Subscription[]      @relation("SubscriberSubscriptions")
  reviews       Review[]            @relation("UserReviews")
  adminTabViews AdminTabView[]      @relation("AdminTabViews")
  follows       Follow[]            @relation("UserFollows")
  pickTails     PickTail[]          @relation("UserPickTails")

  // Referrals. `referralCode` is this user's own code to hand out;
  // `referredById` is who brought them in, set once at signup and never after —
  // attribution that can be edited later isn't attribution.
  referralCode      String?            @unique
  referredById      String?
  referredBy        User?              @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]             @relation("UserReferrals")
  referredAt        DateTime?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  // Live-chat support: chats this user (as an agent) is handling + their
  // online-presence heartbeat.
  agentChats    Chat[]         @relation("AgentChats")
  agentPresence AgentPresence?

  // Blog posts this user (an admin) authored.
  blogPosts BlogPost[] @relation("BlogAuthor")

  // Handicapping-contest entries (Supercapper Contest and any future contests).
  contestEntries ContestEntry[] @relation("UserContestEntries")

  // Per-channel notification opt-outs (in-app is always on). Default on.
  notifyEmail    Boolean @default(true)
  notifyPush     Boolean @default(true)
  notifyTelegram Boolean @default(true)
  notifyDiscord  Boolean @default(true)

  // Linked chat identities for DM notifications (null until the user connects).
  telegramChatId    String?
  telegramLinkToken String? @unique
  discordUserId     String?

  stripeCustomerId String? @unique

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Short numeric email-verification codes used by the signup onboarding flow
// (one active code per email; replaced on resend).
model EmailVerificationCode {
  id         String   @id @default(cuid())
  identifier String   @unique
  code       String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
}

// Password-reset links.
//
// The token is stored HASHED, unlike VerificationToken above. The difference is
// what the token is worth: an email-verification token only confirms an address
// the user already gave us, while a reset token is a bearer credential for the
// whole account. Anyone reading this table — a dump, a backup, a support query
// run against a replica — would otherwise hold a working reset link for every
// pending request. The hash costs nothing and removes that.
//
// One row per request rather than one per email: the request endpoint is public,
// so a single-row-per-email design would let anyone invalidate a real user's
// in-flight reset simply by asking for another one.
model PasswordResetToken {
  id         String   @id @default(cuid())
  // The account's email, lowercased.
  identifier String
  // SHA-256 of the token that went out in the link. Unique so a lookup by hash
  // is a single indexed read and collisions are impossible to store.
  tokenHash  String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model HandicapperProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  handle      String      @unique
  displayName String
  bio         String?     @db.Text
  avatarUrl   String?
  coverUrl    String?
  sports      PickSport[] @default([])
  isVerified  Boolean     @default(false)
  // Soft suspension: hidden from listings, profile 404s, can't post picks or
  // take new subscribers; existing data stays intact.
  suspendedAt DateTime?

  // Social links shown (with icons) on the public profile and cards. Null = not
  // provided. Stored as full normalized URLs.
  xUrl         String?
  instagramUrl String?
  youtubeUrl   String?
  tiktokUrl    String?
  discordUrl   String?
  telegramUrl  String?
  websiteUrl   String?

  // Subscriber pricing packages. Monthly is the required anchor; weekly and
  // annual are optional add-ons (null = the handicapper doesn't offer them).
  monthlyPriceCents Int  @default(2999)
  weeklyPriceCents  Int?
  annualPriceCents  Int?

  // Optional free-trial length (1 or 2 days) applied to weekly/monthly Stripe
  // subscriptions only — never annual. null/0 = no trial.
  subscriptionTrialDays Int?

  // Currency the handicapper's package prices are denominated and charged in
  // (Stripe + crypto). Prices above are integer minor units of this currency.
  priceCurrency PriceCurrency @default(USD)

  // Crypto payout wallets — where the platform sends the handicapper's cut of
  // crypto (NOWPayments) subscriptions. Internal only; never shown publicly.
  payoutEthAddress String?
  payoutBtcAddress String?

  stripeAccountId     String? @unique
  stripeAccountReady  Boolean @default(false)
  stripeProductId     String?
  stripePriceId       String? // monthly package
  stripeWeeklyPriceId String?
  stripeAnnualPriceId String?

  // The handicapper's plan with the platform — controls commission rate
  // (see commissionPercentForPlan in src/lib/plans.ts) and, for GOLD,
  // homepage/leaderboard featuring. Billing here runs on the platform's own
  // Stripe account (no Connect), separate from the stripeAccount* fields
  // above which are for receiving subscriber payments.
  plan                     HandicapperPlan    @default(FREE)
  planInterval             BillingInterval?
  planStatus               SubscriptionStatus @default(ACTIVE)
  planStripeCustomerId     String?            @unique
  planStripeSubscriptionId String?            @unique
  planCurrentPeriodEnd     DateTime?
  planCancelAtPeriodEnd    Boolean            @default(false)
  // Whether this handicapper has already consumed their one-time 1-month free
  // trial on a paid (Silver/Gold) plan — set the first time a trial starts, so
  // canceling and re-subscribing doesn't grant another free month.
  planTrialUsed            Boolean            @default(false)

  picks         Pick[]
  subscriptions Subscription[] @relation("HandicapperSubscriptions")
  followers     Follow[]       @relation("HandicapperFollowers")
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([handle])
}

model Pick {
  id            String             @id @default(cuid())
  handicapperId String
  handicapper   HandicapperProfile @relation(fields: [handicapperId], references: [id], onDelete: Cascade)

  sport     PickSport
  league    String?
  matchup   String
  betType   BetType
  selection String
  odds      Int
  units     Float      @default(1)
  analysis  String?    @db.Text
  result    PickResult @default(PENDING)
  isPremium Boolean    @default(true)

  eventStartsAt   DateTime
  settledAt       DateTime?
  // Who graded this pick: the owner's userId (self), an admin's userId, or
  // "auto" for score-based settlement. Null while pending. The audit column
  // behind the "verified records" promise.
  settledBy       String?
  // Set for picks created from the odds schedule — lets auto-settlement match
  // this pick to a final score.
  oddsApiEventId  String?
  oddsApiSportKey String?
  // The last price this selection was available at before kickoff, and when it
  // was captured. Comparing it to `odds` gives closing line value: whether the
  // market moved toward the pick or away from it. CLV is the one metric that
  // can't be produced by cherry-picking results — you either beat the close or
  // you didn't — which makes it the strongest claim a verified-records site can
  // make. Null when the pick wasn't board-sourced, or the capture didn't run.
  closingOdds     Int?
  closingOddsAt   DateTime?
  // Structured form of the selection, captured from the board when the pick was
  // made off the schedule. Lets the settler grade period markets and player
  // props without parsing the display string. Null for manually-entered picks,
  // which keep grading from `selection` as before.
  marketKey       String?
  side            String?
  linePoint       Float?
  playerName      String?

  // For a PARLAY bet: the individual legs. `odds` on the parent Pick holds the
  // combined (multiplied) American odds; each leg keeps its own line.
  parlayLegs ParlayLeg[]

  // Who backed or faded this pick. Social proof at the point of decision, and
  // the raw material for a consensus view of the whole board.
  tails PickTail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([handicapperId, createdAt])
  @@index([result])
}

// A reader saying they're on a pick, or against it.
//
// One row per user per pick, with the side stored rather than implied, so
// switching from tail to fade is an update rather than a delete plus an insert
// — the count stays right and the history isn't a hole. Only picks the user can
// actually see are tailable; the API enforces that, since a premium pick's
// selection is exactly what a subscription buys.
model PickTail {
  id     String @id @default(cuid())
  pickId String
  pick   Pick   @relation(fields: [pickId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("UserPickTails", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * True = tailed (backing it), false = faded (against it).
   */
  tailed Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pickId, userId])
  @@index([pickId])
  @@index([userId])
}

// One selection within a parlay Pick. Legs are display-only detail; the parlay
// is graded as a whole on the parent Pick.
model ParlayLeg {
  id     String @id @default(cuid())
  pickId String
  pick   Pick   @relation(fields: [pickId], references: [id], onDelete: Cascade)

  sport     PickSport?
  league    String?
  matchup   String
  selection String
  odds      Int
  order     Int        @default(0)

  createdAt DateTime @default(now())

  @@index([pickId])
}

// A subscriber's review of a handicapper: a 1–5 star rating with an optional
// written note, shown on the public profile. Only users who are (or were) paid
// subscribers of the handicapper can leave one — enforced in the API, not the
// schema. One review per subscriber per handicapper (they can edit it).
//
// Reviews are held for admin moderation: a new or edited review lands as PENDING
// and only appears publicly once an admin marks it APPROVED (so foul/hate
// language can be caught first). REJECTED reviews stay hidden.
model Review {
  id            String             @id @default(cuid())
  handicapperId String
  handicapper   HandicapperProfile @relation(fields: [handicapperId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("UserReviews", fields: [authorId], references: [id], onDelete: Cascade)

  rating Int // 1–5 stars
  body   String? @db.Text

  status      ReviewStatus @default(PENDING)
  moderatedAt DateTime?
  moderatedBy String? // admin userId who approved/rejected it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([handicapperId, authorId])
  @@index([handicapperId, status])
  @@index([status, createdAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Per-admin "last viewed" marker for an admin tab. Powers the number bubbles in
// the admin nav for tabs whose badge means "new since you last looked"
// (users, handicappers, subscriptions). Queue tabs (tickets/chats/reviews) badge
// off live state instead and don't need a marker.
model AdminTabView {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation("AdminTabViews", fields: [userId], references: [id], onDelete: Cascade)
  tab    String
  seenAt DateTime @default(now())

  @@unique([userId, tab])
}

// One row per admin mutation — who did what to which record, when.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String
  targetId   String
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Small key-value store for admin-configurable settings (announcement banner,
// cached odds-quota snapshot, ...).
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Subscription {
  id           String @id @default(cuid())
  subscriberId String
  subscriber   User   @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)

  handicapperId String
  handicapper   HandicapperProfile @relation("HandicapperSubscriptions", fields: [handicapperId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  status            SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriberId, handicapperId])
  @@index([handicapperId, status])
}

// A crypto payment for a fixed-length access pass (NOWPayments invoice).
// Crypto can't auto-renew or split funds like Stripe Connect: payments land in
// the platform's NOWPayments account, and confirmed rows double as the earnings
// ledger showing what each handicapper is owed (netCents).
model CryptoPayment {
  id            String @id @default(cuid())
  chargeCode    String @unique // our order id, echoed back by the NOWPayments IPN
  subscriberId  String
  handicapperId String

  interval        BillingIntervalPass
  amountCents     Int // what the subscriber paid (USD-priced)
  commissionCents Int // platform's cut at time of purchase
  netCents        Int // owed to the handicapper

  status      CryptoPaymentStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([handicapperId, status])
  @@index([subscriberId])
}

enum CryptoPaymentStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

enum BillingIntervalPass {
  WEEKLY
  MONTHLY
  ANNUAL
}

// A free "follow": a customer tracking a handicapper's stats without paying
// for their picks. Distinct from Subscription, which is the paid relationship
// that unlocks premium picks.
model Follow {
  id         String @id @default(cuid())
  followerId String
  follower   User   @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)

  handicapperId String
  handicapper   HandicapperProfile @relation("HandicapperFollowers", fields: [handicapperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, handicapperId])
  @@index([handicapperId])
}

// An in-app notification for the bell/notification center. Also the source of
// truth that a given event happened; email and web push are additional
// delivery channels driven off the same fan-out.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // e.g. "pick.new"
  title String
  body  String  @db.Text
  url   String?

  // Loose references (no FK cascade needed — notifications are disposable).
  handicapperId String?
  pickId        String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// A browser Web Push subscription (endpoint + keys) for a user. A user may have
// several (one per device/browser). Removed when the push service reports it's
// gone (404/410).
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Support ticket opened from the contact / FAQ form. Tracks the whole thread of
// messages between the visitor and admins so the discussion has a record.
enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketAuthor {
  CUSTOMER
  ADMIN
}

model Ticket {
  id        String          @id @default(cuid())
  name      String
  email     String
  subject   String?
  // Enquiry category chosen in the contact form (see src/lib/ticket-categories).
  // Nullable for tickets created before the field existed.
  category  String?
  status    TicketStatus    @default(OPEN)
  messages  TicketMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status, updatedAt])
}

model TicketMessage {
  id        String       @id @default(cuid())
  ticketId  String
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    TicketAuthor
  body      String       @db.Text
  createdAt DateTime     @default(now())

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Live chat + AI chatbot
//
// Anonymous visitors open a Chat from the on-site widget. It starts in BOT mode
// (answered by the FAQ chatbot). If the visitor asks for a human it moves to
// WAITING; an admin/support agent claiming it moves it to LIVE. When no agent is
// online the widget falls back to the contact form (which opens a Ticket).
// ---------------------------------------------------------------------------

enum ChatStatus {
  BOT // conversing with the automated assistant
  WAITING // visitor asked for a human, awaiting an agent
  LIVE // an agent has claimed and is handling it
  CLOSED
}

enum ChatAuthor {
  VISITOR
  BOT
  AGENT
  SYSTEM
}

model Chat {
  id           String        @id @default(cuid())
  // Random secret returned once at creation; the anonymous visitor's browser
  // must present it to read or post to this chat (keeps threads private).
  token        String        @default(cuid())
  visitorName  String?
  visitorEmail String?
  status       ChatStatus    @default(BOT)
  // The agent currently handling a LIVE chat (null while in BOT/WAITING).
  agentId      String?
  agent        User?         @relation("AgentChats", fields: [agentId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  chatId    String
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author    ChatAuthor
  body      String     @db.Text
  createdAt DateTime   @default(now())

  @@index([chatId, createdAt])
}

// Heartbeat table: an admin/support agent is "online" while lastSeen is recent
// (the admin Chat tab pings it periodically). Drives whether the visitor widget
// offers live chat or falls back to the contact form.
model AgentPresence {
  userId   String   @id
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeen DateTime @default(now())

  @@index([lastSeen])
}

// A blog / content post for SEO and top-of-funnel traffic. Authored in the admin
// Blog tab (rich-text HTML body), published to /blog and /blog/[slug]. Only
// PUBLISHED posts (with a publishedAt in the past) are shown publicly.
enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String  @id @default(cuid())
  // URL slug, unique and lowercased (e.g. "how-we-verify-records").
  slug          String  @unique
  title         String
  // Short summary for listing cards, meta description, and social preview.
  excerpt       String  @db.Text
  // Rich-text HTML body, authored in the admin editor.
  contentHtml   String  @db.Text
  // Optional hero/social image URL (Vercel Blob or any allowed remote host).
  coverImageUrl String?

  status      BlogStatus @default(DRAFT)
  // When it went (or is scheduled to go) live. Set on first publish.
  publishedAt DateTime?

  authorId String
  author   User   @relation("BlogAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

// A one-time crypto payment (NOWPayments) for a handicapper's own Silver/Gold
// plan — the crypto alternative to the recurring Stripe plan subscription.
// Prepaid and fixed-term: it activates the plan for one interval and never
// auto-renews (paying again extends from the current end date).
model PlanCryptoPayment {
  id            String @id @default(cuid())
  chargeCode    String @unique // our order id (blitzplan_…), echoed by the IPN
  handicapperId String

  plan        HandicapperPlan
  interval    BillingInterval
  amountCents Int

  status      CryptoPaymentStatus @default(PENDING)
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([handicapperId, status])
}

// Generic fixed-window rate limiter shared across serverless instances (there's
// no Redis). One row per bucket key (e.g. "register:1.2.3.4"); `count` resets
// whenever `windowStart` ages past the caller's window.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// ─── Handicapping contests (e.g. the Supercapper Contest) ───────────────────
// A free, ROI-ranked contest any user can enter by submitting picks during the
// window. Ranked by ROI over settled picks, with a minimum-pick floor so a
// couple of lucky bets can't win. Prizes are split across the top N places.
enum ContestStatus {
  DRAFT
  OPEN
  CLOSED
  SETTLED
}

model Contest {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  name                 String
  tagline              String?
  // Guaranteed pool (equals the sum of prizeSplitCents), stored in cents.
  prizePoolCents       Int
  currency             String        @default("USD")
  // Cents awarded to each place; index 0 = 1st. Length = number of winners.
  prizeSplitCents      Int[]         @default([])
  // Minimum settled picks an entry needs before it's ranked.
  minPicks             Int           @default(20)
  startsAt             DateTime
  endsAt               DateTime
  // Entries close on this date (defaults to endsAt when null). After it, the
  // field — and therefore the number of paid places — is locked.
  registrationClosesAt DateTime?
  // When true, paid places scale with the number of entrants (one extra place
  // per 10 joiners, min 3) and the ladder is derived from prizePoolCents rather
  // than the stored prizeSplitCents.
  dynamicPayouts       Boolean       @default(false)
  status               ContestStatus @default(DRAFT)
  settledAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  entries ContestEntry[]
  ipLogs  ContestIpLog[]

  @@index([status])
}

model ContestEntry {
  id                 String    @id @default(cuid())
  contestId          String
  contest            Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation("UserContestEntries", fields: [userId], references: [id], onDelete: Cascade)
  // Final standings, written when the contest is settled.
  finalRank          Int?
  prizeCents         Int?
  paidAt             DateTime?
  // Anti-fraud: a disqualified entry is excluded from the standings and payouts.
  disqualifiedAt     DateTime?
  disqualifiedReason String?
  // Contest avatar, shown wherever this entrant appears on the contest pages.
  // Only used for entrants who aren't handicappers — a handicapper's contest
  // identity reuses their handicapper profile avatar (see entrantAvatar).
  avatarUrl          String?
  createdAt          DateTime  @default(now())

  picks  ContestPick[]
  ipLogs ContestIpLog[]

  @@unique([contestId, userId])
  @@index([contestId])
}

// Fraud signal log: the IP + device an entrant used when joining a contest and
// each time they submitted a pick. Shared IPs / devices across entries are the
// primary multi-account / collusion signal surfaced to admins.
model ContestIpLog {
  id        String       @id @default(cuid())
  contestId String
  contest   Contest      @relation(fields: [contestId], references: [id], onDelete: Cascade)
  entryId   String
  entry     ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  ip        String
  userAgent String?
  action    String // "join" | "pick"
  createdAt DateTime     @default(now())

  @@index([contestId, ip])
  @@index([entryId])
}

model ContestPick {
  id              String       @id @default(cuid())
  entryId         String
  entry           ContestEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sport           PickSport
  league          String?
  matchup         String
  selection       String
  // How to grade the selection (MONEYLINE / SPREAD / TOTAL / PROP). Required by
  // the auto-settler, which parses the selection differently per type.
  betType         BetType      @default(MONEYLINE)
  odds            Int
  units           Float        @default(1)
  result          PickResult   @default(PENDING)
  eventStartsAt   DateTime
  settledAt       DateTime?
  settledBy       String?
  // The upstream game this pick came off. Contest picks must be taken from our
  // odds board, so these are always set — they're what lets the cron grade the
  // pick from the feed's final scores.
  oddsApiEventId  String?
  oddsApiSportKey String?
  // Structured form of the selection, captured from the board at submission so
  // grading never has to parse the display string. marketKey identifies the
  // market ("totals_h1", "player_points"); side is the team or Over/Under/Yes;
  // linePoint is the number; playerName is set for player props.
  marketKey       String?
  side            String?
  linePoint       Float?
  playerName      String?
  createdAt       DateTime     @default(now())

  @@index([entryId])
  @@index([result])
  @@index([result, eventStartsAt])
}

/**
 * A post sent to a Telegram channel through the bot.
 * This is the *owned-channel* half of Telegram promotion. Telegram's paid ad
 * platform (ads.telegram.org) has no public API — no endpoint creates a
 * campaign or returns its stats — so paid spend is recorded by hand in
 * AdSpendEntry instead. Broadcasting to a channel we control is the part that
 * can actually be automated, and it reaches the same audience.
 */
model TelegramBroadcast {
  id          String   @id @default(cuid())
  /// Target as entered: @channelhandle or a numeric chat id.
  chatId      String
  /// Channel title at send time, so history stays readable after a rename.
  chatTitle   String?
  text        String
  /// Attached file under public/marketing. Null for a text-only post.
  asset       String?
  /// Telegram's message id — what you need to find or delete the post later.
  messageId   String?
  /// Failures are kept, not discarded: a broadcast that didn't land is the
  /// thing you most need to see in the history.
  ok          Boolean  @default(false)
  error       String?
  /// Null for a manual post from the admin panel; otherwise what triggered it
  /// (e.g. "free-pick"). Kept as its own column rather than encoded into
  /// sentByEmail, so the history can tell an automatic post from a person's.
  source      String?
  sentById    String
  sentByEmail String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/**
 * Manually recorded ad spend, for platforms with no API to pull it from.
 * Telegram Ads is the reason this exists, but `platform` is free text rather
 * than an enum so Reddit, TikTok or a podcast sponsorship can be logged here
 * too without a migration per network. Meta is deliberately NOT recorded here —
 * its numbers come live from the Marketing API, and a hand-typed second copy of
 * a figure the API already owns would only ever drift.
 */
model AdSpendEntry {
  id          String   @id @default(cuid())
  platform    String
  campaign    String
  /// The day the spend applies to, not when it was typed in.
  spentOn     DateTime
  spendCents  Int
  currency    String   @default("USD")
  impressions Int?
  clicks      Int?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([platform, spentOn])
}

/**
 * The X (Twitter) account the admin panel posts as.
 * A row, not a SiteSetting pair, because posting to X needs a live credential
 * rather than a static token. Unlike Telegram — where one bot token in the
 * environment is the whole story — X will only accept a post in *user context*,
 * so the panel holds an OAuth grant that expires and has to be refreshed.
 * Single-row by construction: `id` is a fixed key, so connecting a different
 * account replaces the grant instead of quietly accumulating several and
 * leaving "which one did that post go to?" unanswerable.
 */
model XAccount {
  /// Always "default". One connected account, enforced by the primary key.
  id           String   @id @default("default")
  /// X's numeric user id — stable across handle changes, unlike `username`.
  xUserId      String
  /// Handle at connect time, for display. Re-read on refresh.
  username     String
  name         String?
  /// Encrypted at rest: these are live credentials, not identifiers. A leaked
  /// refresh token is an account takeover, so unlike the Discord user id next
  /// door these never sit in the database in the clear.
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  /// When the access token dies. Refreshed ahead of this, not after it.
  expiresAt    DateTime
  /// Granted scopes, so the UI can say why a post was rejected rather than
  /// showing a bare 403.
  scopes       String
  connectedAt  DateTime @default(now())
  connectedBy  String
  updatedAt    DateTime @updatedAt
}

/**
 * Every post the panel has attempted, successful or not.
 * Deliberately shaped like TelegramBroadcast: a failed send is the row you most
 * want to see, so failures are kept rather than discarded.
 */
model XPost {
  id          String   @id @default(cuid())
  /// Handle posted as, captured at send time so history survives a rename.
  username    String
  text        String
  /// Attached file under public/marketing. Null for a text-only post.
  asset       String?
  /// X's tweet id — what you need to find or delete the post later.
  tweetId     String?
  ok          Boolean  @default(false)
  error       String?
  /// Null for a manual post; otherwise what triggered it, matching the same
  /// column on TelegramBroadcast.
  source      String?
  sentById    String
  sentByEmail String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// --- Blitz Odds -------------------------------------------------------------
// Private line-movement watcher. Polls the odds feed, keeps a short history of
// every price it sees, and raises an alert when a selection shortens at more
// than one sportsbook before kickoff.

// RETIRED — the five Odds* models below belonged to the Blitz Odds watcher,
// which has been removed. Nothing reads or writes them any more.
//
// They are left declared on purpose: dropping the tables is irreversible, and
// removing the models without a migration would leave the schema permanently
// out of step with the database. When the data is confirmed unwanted, delete
// these five models and generate one migration that drops the tables.

/**
 * One price, from one book, for one selection, at one moment.
 * This is the only table in the app that grows with time rather than with user
 * activity, so it is pruned aggressively (see pruneSnapshots): a drop is
 * detected against a lookback of minutes, and nothing here has any value once
 * the game has started.
 */
model OddsSnapshot {
  id String @id @default(cuid())

  /// The Odds API event id, and the league key it came from.
  eventId  String
  sportKey String

  /// Market + selection identify what was priced. `point` separates the rungs
  /// of a handicap or total — "Over 8.5" and "Over 9.5" are different bets and
  /// must never be compared to each other.
  marketKey String
  selection String
  point     Float?

  bookmaker String
  /// American, as the feed returns it and as picks are stored.
  price     Int

  commenceTime   DateTime
  /// Minutes remaining before kickoff at the moment this price was captured.
  ///
  /// Stored rather than derived at read time because every rule in this tool is
  /// expressed relative to kickoff, and a poll that arrives late must be judged
  /// on when it actually landed — not on when it was scheduled to.
  minutesToStart Int
  capturedAt     DateTime @default(now())

  // The detector reads one (event, market, selection, point) line across books
  // over a short window; this index is that query.
  @@index([eventId, marketKey, selection, point, capturedAt])
  @@index([capturedAt])
}

/**
 * A detected shortening, confirmed across at least `bookCount` books.
 * Kept after notification so the panel has a feed and so a repeat move on the
 * same selection can be measured against what was already reported rather than
 * re-alerting on the same drift.
 */
model OddsDrop {
  id String @id @default(cuid())

  eventId      String
  sportKey     String
  sport        PickSport
  matchup      String
  commenceTime DateTime

  marketKey   String
  /// Human label for the market, resolved at detection time so the feed reads
  /// the same as the pick forms.
  marketLabel String
  selection   String
  point       Float?

  /// Books that moved, and the size of the move in implied-probability points
  /// (not raw American, which is non-linear — see lib/blitz-odds).
  bookCount    Int
  books        String
  openPrice    Int
  currentPrice Int
  probDelta    Float

  /// Minutes to kickoff at each side of the comparison, frozen at detection
  /// time. Stored rather than recomputed because a delayed poll must not be
  /// reported as though it had sampled the windows precisely.
  baselineMinutes Int
  minutesToStart  Int

  notifiedAt DateTime?
  detectedAt DateTime  @default(now())

  @@index([detectedAt])
  @@index([eventId, marketKey, selection, point])
}

/**
 * What the watcher is allowed to do. A single row (id = "default").
 * Every field here exists to bound spend. The feed bills per request as
 * (markets x regions), so an unbounded watcher is an unbounded bill — the whole
 * rest of the site runs on roughly 1,600 credits a month, and a naive poller
 * would exceed that before lunch.
 */
model OddsWatchSettings {
  id String @id @default("default")

  enabled Boolean @default(false)

  /// Which feed the watcher reads. "oddsapi" is the same provider the public
  /// board uses; "rundown" is a separate subscription reached only by this tool.
  ///
  /// Worth keeping separate rather than switching the whole site: the two bill
  /// on completely different axes — the Odds API per (markets x regions), so
  /// asking for more costs more, and Rundown per request, so it doesn't. A
  /// runaway watcher on its own provider also cannot take the public board's
  /// odds down with it.
  ///
  /// Defaults to oddsapi because the Rundown adapter's field mapping has never
  /// met a live response; see lib/blitz-odds-rundown.
  provider String @default("oddsapi")

  /// Effective poll cadence in minutes — how often a cycle actually runs, NOT
  /// how often the workflow is scheduled. The workflow fires every 5 minutes and
  /// polls 5 times within each run, so the real figure is 1. Used to project
  /// spend and to warn when the cadence is too slow for the alert band.
  pollMinutes Int @default(1)

  /// The two windows the whole tool turns on, in minutes before kickoff.
  ///
  /// Baseline is drawn from [baselineTo, baselineFrom] — 16-30 minutes out by
  /// default — and compared against a price inside the alert band
  /// [alertTo, alertFrom], 10-15 minutes out.
  ///
  /// The alert band has a FLOOR as well as a ceiling on purpose. An alert that
  /// arrives two minutes before kickoff is not actionable, and the point of the
  /// floor is to guarantee there is still time to place the bet when the message
  /// lands.
  ///
  /// Nothing outside these bands is ever fetched, which is what keeps the tool
  /// affordable: the 0-9 minute run-in and everything beyond 30 minutes cost
  /// nothing at all.
  baselineFromMinutes Int @default(30)
  baselineToMinutes   Int @default(16)
  alertFromMinutes    Int @default(15)
  alertToMinutes      Int @default(10)

  /// Books to price against, as comma-separated feed keys. Up to ten bill as a
  /// single region, so a short list costs no less than a long one — but one
  /// invalid key rejects the entire request, so this is not a field to
  /// experiment in blind. `booksSeen` on the run log reports which answered.
  bookmakers String @default("bet365,betano")

  /// A move must be at least this many implied-probability points, and appear
  /// at this many distinct books, to raise an alert.
  minProbDelta Float @default(2.0)
  minBooks     Int   @default(2)

  /// Market depth. Game lines come from one bulk request per league and are
  /// cheap; the rest are per-event and are where the bill is made.
  watchGameLines    Boolean @default(true)
  watchAlternates   Boolean @default(false)
  watchProps        Boolean @default(false)
  watchSoccerExtras Boolean @default(false)

  /// Hard ceiling. The poller stops when the day's spend reaches this, and says
  /// so, rather than quietly draining the quota.
  dailyCreditCap Int @default(2000)
  /// Most events to deepen in one run, so an unusually busy slate cannot make
  /// a single run cost multiples of a normal one.
  maxDeepEvents  Int @default(20)

  /// Leagues to watch. Empty = every league the board already carries.
  sportKeys String @default("")

  /// Cached league resolution, and when it was taken.
  ///
  /// Resolving soccer probes nine dormant competition keys, and each probe is a
  /// billed request. At a ten-minute cadence that is over a thousand credits a
  /// day spent deciding *what* to watch, before watching anything — so the
  /// answer is cached here on its own slow schedule rather than left to the
  /// framework's fetch cache, which is invisible, not guaranteed to survive
  /// between serverless invocations, and the wrong thing to trust with money.
  leaguesJson String    @default("")
  leaguesAt   DateTime?

  /// Where alerts go.
  notifyOnSite   Boolean @default(true)
  notifyPush     Boolean @default(true)
  notifyTelegram Boolean @default(true)

  /// Private Telegram destination — a direct chat with the bot, NOT the public
  /// broadcast channel. Held separately from the broadcast target on purpose:
  /// this tool is private, and a shared setting is one mistake away from
  /// pushing line movement to every subscriber. Falls back to
  /// TELEGRAM_ALERT_CHAT_ID when blank; alerts are skipped if neither is set.
  telegramChatId String @default("")

  updatedAt DateTime @updatedAt
}

/**
 * One run of the watcher, with what it cost.
 * The credit column is the point: spend is invisible until it is on a page, and
 * this is what the panel's usage meter and the daily cap are both computed from.
 */
model OddsPollRun {
  id String @id @default(cuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// Billed units consumed, counted as (markets x regions) per request the same
  /// way the upstream bills them.
  credits  Int @default(0)
  requests Int @default(0)

  eventsSeen Int @default(0)
  dropsFound Int @default(0)

  /// Books that actually returned a price this run, comma separated.
  ///
  /// The one reliable way to tell a wrong book key from a book that simply is
  /// not pricing a game. The feed rejects an unknown key by failing the whole
  /// request, so a configured book that never appears here is the first thing
  /// to check when nothing ever alerts.
  booksSeen String @default("")

  /// Set when the run stopped early — budget cap hit, feed unavailable.
  stoppedReason String?
  error         String?

  @@index([startedAt])
}

/**
 * Upcoming kickoffs, refreshed on a slow schedule.
 * This exists purely to avoid paying to find out that nothing is starting soon.
 * The watcher only cares about games inside the last half hour before kickoff,
 * and most leagues, most of the time, have none — but discovering that by
 * requesting odds costs the same as requesting odds for a full slate.
 * The upstream's events endpoint is far cheaper than an odds request, so the
 * schedule is fetched from there occasionally and every poll in between reads
 * this table for free. On a quiet hour the watcher makes no odds requests at
 * all.
 */
model OddsFixture {
  id String @id @default(cuid())

  eventId  String    @unique
  sportKey String
  sport    PickSport

  matchup      String
  commenceTime DateTime

  refreshedAt DateTime @default(now())

  // The poll's only question: which leagues have a game starting soon.
  @@index([commenceTime])
  @@index([sportKey, commenceTime])
}
