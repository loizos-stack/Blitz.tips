{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && sh scripts/migrate-deploy.sh && next build",
  "crons": [
    {
      "path": "/api/cron/auto-settle",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/expire-passes",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/subscriber-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/comped-plans",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "17 3 * * *"
    }
  ]
}
